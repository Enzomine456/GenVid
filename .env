# Arquivo de configuração de variáveis de ambiente para GenVid

# Chave secreta para segurança da aplicação
SECRET_KEY=your-secret-key-here

# URL do banco de dados (SQLite por padrão)
DATABASE_URL=sqlite:///genvid.db

# Chave da API OpenAI (não utilizada neste projeto)
# OPENAI_API_KEY=your-openai-api-key-here